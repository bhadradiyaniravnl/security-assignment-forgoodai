# Copy to secrets/.env (gitignored). Read only by deploy/secrets.sh, which turns it
# into a Kubernetes Secret mounted solely into the credproxy pod.
ANTHROPIC_API_KEY=
# Only needed if the key is NOT scoped to a workspace (prefer a workspace-scoped key with a spend limit).
# ANTHROPIC_WORKSPACE_ID=
# GitHub App (testwriter-agent): numeric App ID; private key goes in secrets/github-app.pem
# GITHUB_APP_ID=
