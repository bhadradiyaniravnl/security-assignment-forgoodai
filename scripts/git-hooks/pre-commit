#!/usr/bin/env bash
# Blocks commits that stage credentials. Enable with: make hooks
# Uses gitleaks when installed; always runs the built-in checks below.
set -euo pipefail
fail=0

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner || fail=1
fi

# 1. Nothing under secrets/ may be committed except the empty template.
while IFS= read -r f; do
  case "$f" in
    secrets/.example.env) ;;
    secrets/*) echo "pre-commit: refusing to commit $f" >&2; fail=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2. The template must not carry a value for any key.
if git diff --cached --name-only | grep -qx 'secrets/.example.env'; then
  if git show :secrets/.example.env | grep -Eq '^[A-Z_]+=.+'; then
    echo "pre-commit: secrets/.example.env must only contain empty KEY= lines" >&2; fail=1
  fi
fi

# 3. Credential-shaped strings in any staged addition.
if git diff --cached -U0 | grep -E '^\+' | grep -Eq 'sk-ant-[a-z0-9]+-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
  echo "pre-commit: staged change contains a credential-shaped string" >&2; fail=1
fi

exit $fail
